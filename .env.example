APP_NAME=LearnFlow AI
SECRET_KEY=replace-this-with-a-long-random-value
# Local development database. OCI deployment uses the ORACLE_* values below.
DATABASE_URL=sqlite:///./learnflow.db
ADMIN_EMAIL=admin@example.com
# OCI Autonomous Database (leave blank for local SQLite)
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
ORACLE_WALLET_DIR=/app/wallet
ORACLE_WALLET_PASSWORD=
# Set these only after configuring Gemini AI. The app works without them.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
